###############
## IRC Server
###############
# for testing this hash is 'password'
IRC_SUPER_ADMIN_PASSWORD="$2a$10$7w82iJDU7941avC65WYLJuJL0p7hIaGVye8pq95farNt7DD5dDGga"
IRC_DEFAULT_SERVER_NAME="Z.IRC"
IRC_SERVER_DNS_NAME="zzirc.com"
IRC_SERVER_VERSION="v1.0.0"
IRC_SERVER_CAPABILITIES="sasl"
# o: IRC operator
# i: Invisible (user won't appear in channel user lists unless they are in the same channel)
# w: Receive wallops (messages sent to all IRC operators)
# s: Receive server notices
# Note: Just because a mode is listed here doesn't mean the user currently has it; it just indicates that the mode is available on the server.
IRC_USER_MODES="oiws"
# see mode.go for full list of channel modes
IRC_CHANNEL_MODES="beiklmnopPst"
# password should be generated and hashed then entered here
# **NOTE** you must escape `$` characters otherwise they are interpolated as variables
# Use the below hash as a test password - the password is 1235
# IRC_SERVER_PASSWORD="\$2a\$10\$RFRaJiN40EzL9.nvfq4uy.w6UHs7WuF3EkBpxj.xUPjNd8tUs7sfi"
IRC_SERVER_PASSWORD=""
IRC_SERVER_INIT_WORKER_COUNT="3"
IRC_MAX_BUFFER_SIZE="8192"
IRC_MAX_USER_CHANNELS="20"
# IRC_HOST="127.0.0.1"
IRC_SERVER_MANAGER_PORT="7000"
IRC_HOST="0.0.0.0"
IRC_PORT="6667"
IRC_TLS_PORT="6697"
IRC_TLS_CERT_PATH="./.tls/server.crt"
IRC_TLS_KEY_PATH="./.tls/server.key"
IRC_ENABLE_TLS="false"
IRC_VERSION="302"
IRC_USE_USER_PASS="true" # When true, will not ask the user to authenticate again to use chat, but will log them in via their password automatically
IRC_CHAT_SERVER_LOG_LEVEL="3" # info https://pkg.go.dev/github.com/phuslu/log@v1.0.110#Level

IRC_DB_HOST="zirc_db"
IRC_DB_PORT="5432"
IRC_DB_USER="postgres"
IRC_DB_PASSWORD="password"
IRC_DB_DATABASE="postgres"
IRC_DB_APPLICATION_NAME="zirc_server"
IRC_DB_ENABLE_TLS="false"
IRC_DB_TLS_CERT_PATH="./.tls/db.crt"
IRC_DB_TLS_KEY_PATH="./.tls/db.key"
IRC_DB_RECONNECT_WAIT_INTERVAL="3"

# ONLY FOR TESTING, below hash is "password"
# generally will use multiple fallback options for password with this env var as the last choice
IRC_S2S_PASSWORD="$2a$10$7w82iJDU7941avC65WYLJuJL0p7hIaGVye8pq95farNt7DD5dDGga"
IRC_S2S_PORT="7000"
IRC_S2S_TLS_PORT="7001"
IRC_S2S_ENABLE_TLS="false"
IRC_S2S_TLS_CERT_PATH="./.tls/s2s.crt"
IRC_S2S_TLS_KEY_PATH="./.tls/s2s.crt"
IRC_S2S_MAX_BUFFER_SIZE="262144" # 256KB

###############
## Auth Server
###############
# AUTH_SERVER_HOST="127.0.0.1"
AUTH_SERVER_HOST="zirc_auth_server"
AUTH_SERVER_PORT="54666"
AUTH_SERVER_ADMIN_KEY="test"

###############
## MongoDB
###############
MONGODB_CONN_STRING="mongodb://zirc_mongo:27017"
MONGODB_NAME="ZIRC"
MONGODB_CHAT_MESSAGE_DB_NAME="ChatMessages"
MONGODB_CHAT_SERVER_CONFIG_DB_NAME="ChatServerConfig"
MONGODB_CHAT_SERVER_RPL_ISUPPORT_COLLECTION_NAME="RPL_ISUPPORT"
MONGODB_CHAT_COMMAND_DESCRIPTIONS_COLLECTION_NAME="CommandDescriptions"
MONGODB_CHAT_MESSAGES_COLLECTION_NAME="ChatMessages"
MONGODB_CHAT_USERS_COLLECTION_NAME="ChatUsers"
MONGODB_CHAT_SERVER_COLLECTION_NAME="ChatServer"
MONGODB_SERVERS_COLLECTION_NAME="Servers"
MONGODB_CHAT_SCHEMA_PATH="attributes"

